	hierarchy Calendario
		lineageTag: 3e5f44d2-fd9d-40b9-9801-dac47c59ade5

		level Ano
			lineageTag: 31dd567f-c25d-4e65-b47b-2c2a0a3b8231
			column: Ano

		level Mês
			lineageTag: 5f80d814-bd2b-4549-a4d6-768519d829ca
			column: MesAno

		level Dia
			lineageTag: a8b60e0a-fabc-439a-ba51-d10d7628d269
			column: Date

	partition dimCalendar = calculated
		mode: import
		source =
				
				VAR _MinDate = DATE( 2016, 1, 1)
				VAR _MaxDate = DATE (2018, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(_MinDate, _MaxDate),
				    "Ano", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "Dia", DAY([Date]),
				    "Mes", FORMAT([Date], "mmmm"),
				    "MesAno", FORMAT ( [Date], "MMM YYYY" ),
				    "MesAnoOrdem", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				
				)

	annotation PBI_Id = e07a029e18b443d3bd882736cfdbb1d6

